# LiveKit credentials. The operator mints its own JWT at startup.
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Room (session) name. Must match the robot / teleoperator / other
# operators participating in the same session.
LIVEKIT_ROOM=portal-hitl

# Moondream Cloud API key (https://moondream.ai/c/account/api-keys).
MOONDREAM_API_KEY=

# Optional: log level for the operator process. INFO is the default.
# LOG_LEVEL=DEBUG

# --- Slider control loop -------------------------------------------------
# Knobs for the AprilTag-driven Y-axis controller invoked by move_to().

# AprilTag family the slider fiducial belongs to. Default matches the
# physical tag printed on the leslider rig.
# SLIDER_APRILTAG_FAMILY=tag16h5

# Optional: pin the controller to a specific tag ID. When unset, the
# lowest-ID detected tag wins. Set this if the overhead camera can see
# tags that are not the slider's.
# SLIDER_APRILTAG_ID=0

# Magnitude of slider.vel sent during the bang-bang loop. Raw motor
# velocity units; should sit between LESLIDER_MIN_VELOCITY and
# LESLIDER_MAX_VELOCITY on the robot side.
# SLIDER_MOVE_VELOCITY=800

# Pixel tolerance on Y between target and tag center. Loop exits with
# reached=true once |delta_y| drops below this.
# SLIDER_MOVE_THRESHOLD_PX=20

# Hard timeout on the loop. Loop exits with reason=timeout if it
# elapses before convergence.
# SLIDER_MOVE_TIMEOUT_S=15

# Consecutive ticks without an AprilTag detection before bailing with
# reason=tag_lost. Default is ~1s at 30 Hz.
# SLIDER_TAG_MISS_LIMIT=30

# Consecutive ticks with |delta| < threshold required before the loop
# declares reason=reached. Filters out one-frame spurious AprilTag
# detections that happen to decode near the target X, and gives the
# slider time to actually settle inside the window (the loop sends
# slider.vel=0 while we're inside but not yet confirmed). Default 3.
# SLIDER_REACHED_HOLD_TICKS=3

# Flip the sign of slider.vel if the rig drives away from the target
# on the first run. Camera mount + slider polarity decide which sign
# corresponds to "down on the image", so this is a one-time per-rig
# calibration.
# SLIDER_VEL_INVERT=false

# --- reset_pose RPC ------------------------------------------------------
# Per-joint targets for the rest pose, in whatever units the follower
# reports (degrees for the SO-101 lerobot follower). Any unset joint
# defaults to 0.0. On a calibrated SO-101 zero is roughly straight-up;
# you almost certainly want to override these for your rig.
# RESET_POSE_SHOULDER_PAN=0.0
# RESET_POSE_SHOULDER_LIFT=0.0
# RESET_POSE_ELBOW_FLEX=0.0
# RESET_POSE_WRIST_FLEX=0.0
# RESET_POSE_WRIST_ROLL=0.0
# RESET_POSE_GRIPPER=0.0

# Max per-tick per-joint position delta sent to the arm. Caps ramp speed
# so a reset from an extreme pose doesn't jerk the arm. At 30 fps the
# default below is 60 units/s.
# RESET_POSE_MAX_STEP=2.0

# Each joint must land within this many units of its target before the
# RPC declares reached.
# RESET_POSE_TOLERANCE=2.0

# Hard timeout on the reset loop. Exits with reason=timeout if it
# elapses before convergence.
# RESET_POSE_TIMEOUT_S=10

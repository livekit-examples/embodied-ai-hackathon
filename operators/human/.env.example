# LiveKit credentials. The operator mints its own JWT at startup.
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Room (session) name. Must match the robot and any other operators
# participating in the same session.
LIVEKIT_ROOM=portal-hitl

# Optional override of the fps declared in portal.yaml.
# PORTAL_FPS=30

# Optional: log level for the operator process. INFO is the default.
# LOG_LEVEL=DEBUG

# --- SO-101 leader arm ---------------------------------------------------
# Serial port for the leader arm. macOS: /dev/tty.usbmodem*. Linux:
# /dev/serial/by-id/...
SO101_LEADER_PORT=

# Calibration file identifier. First connect walks the leader through
# ranges of motion; subsequent connects reuse the saved file at
# ~/.cache/huggingface/lerobot/calibration/<id>.
# SO101_LEADER_ID=so101_leader

# --- Slider drive (arrow keys on the leader's own listener) --------------
# Cruise velocity when ←/→ is held. Trimmed live with ↑/↓.
# LESLIDER_CRUISE_VELOCITY=1500
# LESLIDER_SPEED_INCREMENT=250
# LESLIDER_MIN_VELOCITY=100
# LESLIDER_MAX_VELOCITY=3000

# Flip the slider's left/right convention if the rig drives the wrong
# way on first run.
# LESLIDER_INVERT_SLIDER=false

# LiveKit credentials. The operator mints its own JWT at startup.
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Room (session) name. Must match the robot / teleoperator / other
# operators participating in the same session.
LIVEKIT_ROOM=portal-hitl

# Optional: log level for the operator process. INFO is the default.
# LOG_LEVEL=DEBUG

# --- Policy checkpoints --------------------------------------------------
# Default named policies. Each must point at a HuggingFace-style
# pretrained_model directory (the one containing config.json + the
# safetensors weights), as produced by
# utils/data_collection/policies/act/train.py.
#
# These are only consulted when no --policy NAME=PATH flag is passed on
# the CLI. Either / both can be omitted if you'd rather pass --policy
# flags directly.

# PICK_UP_CHECKPOINT=/absolute/path/to/pick_up/checkpoints/last/pretrained_model
# PUT_DOWN_CHECKPOINT=/absolute/path/to/put_down/checkpoints/last/pretrained_model

# Pre-select a registered policy at startup so the tick loop is warm
# before any run_policy() RPC. The operator still does NOT auto-claim
# the active-operator slot — a peer (or teleop `c`) handles that. Unset
# to start parked.
# RUN_POLICY_DEFAULT=pick_up

# --- Tick loop -----------------------------------------------------------

# Override the Portal config path. By default the operator looks for
# ./portal.yaml then ../../portal.yaml (the shared one at the repo root).
# PORTAL_CONFIG=/absolute/path/to/portal.yaml

# Control / observation tick rate, in Hz. Must match what the robot
# side publishes; 30 is the project default.
# PORTAL_FPS=30

# Task prompt fed to the policy each tick. ACT ignores this for most
# checkpoints, but multimodal / language-conditioned policies will use
# it as part of the input batch.
# LESLIDER_TASK=Pick the blue cube up and hold it

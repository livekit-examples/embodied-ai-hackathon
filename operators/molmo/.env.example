# LiveKit credentials. The robot, teleoperator, and policy processes must all
# use credentials for the same LiveKit project.
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Room (session) name. All three processes must agree.
LIVEKIT_ROOM=portal-hitl

# Optional override of the fps declared in portal.yaml.
# PORTAL_FPS=30

# --- Molmo policy (inference.py) -----------------------------------------
MOLMO_MODEL=allenai/MolmoAct2-SO100_101
MOLMO_DTYPE=bfloat16
MOLMO_NUM_STEPS=10
MOLMO_WARMUP=2

# Optional task prompt threaded into Molmo.
# LESLIDER_TASK=Pick the blue cube up and hold it

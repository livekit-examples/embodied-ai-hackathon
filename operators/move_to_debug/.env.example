# LiveKit credentials. The operator mints its own JWT at startup.
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Room (session) name. Must match the robot / teleoperator / other
# operators participating in the same session.
LIVEKIT_ROOM=portal-hitl

# Moondream Cloud API key (https://moondream.ai/c/account/api-keys).
MOONDREAM_API_KEY=

# Optional: log level for the operator process. INFO is the default.
# LOG_LEVEL=DEBUG

# --- Debug tracking loop ------------------------------------------------
# All knobs below shape the read-only `move_to(description)` RPC. None
# of them affect the robot — this operator never publishes actions.

# AprilTag family the slider fiducial belongs to. Default matches the
# physical tag printed on the leslider rig.
# SLIDER_APRILTAG_FAMILY=tag16h5

# Optional: pin the detector to a specific tag ID. When unset, the
# lowest-ID detected tag wins. Set this if the overhead camera can see
# tags that are not the slider's.
# SLIDER_APRILTAG_ID=0

# How long the tracking loop runs before returning. Default 20s.
# DEBUG_TRACK_TIMEOUT_S=20

# Minimum seconds between consecutive AprilTag detection prints.
# Detector still runs every tick; this only gates console output so
# the log stays readable at high fps. Default 1.0s.
# DEBUG_TAG_PRINT_INTERVAL_S=1.0

# How often (seconds) to re-run Moondream `point` to relocate the
# requested object. Each call is an HTTP round-trip (~hundreds of ms),
# so values below ~0.5s will overlap. Default 1.0s.
# DEBUG_OBJECT_DETECT_INTERVAL_S=1.0

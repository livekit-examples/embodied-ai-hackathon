# LiveKit credentials. The robot, teleoperator, and policy processes all
# read these to mint their own tokens at startup.
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Room (session) name. All three processes must agree.
LIVEKIT_ROOM=portal-hitl

# Optional override of the fps declared in portal.yaml.
# PORTAL_FPS=30

# --- Robot (robot.py) — physical leslider follower -----------------------
# All seven motors share one Feetech bus on this serial port.
LESLIDER_PORT=/dev/ttyACM0
LESLIDER_ID=leslider

# Camera: arm-mounted. Override device path or resolution if needed.
LESLIDER_CAM_ARM=/dev/video0
LESLIDER_CAM_WIDTH=640
LESLIDER_CAM_HEIGHT=480

# Per-tick relative motion cap (None = unlimited). Set in degrees if
# leader.use_degrees is True. Recommended for safety during teleop.
# LESLIDER_MAX_RELATIVE_TARGET=10

# Read motor currents in the observation (adds 7 *.current fields). Off
# by default — we keep the wire schema lean. Flipping this on requires
# extending portal.yaml and the robot code in lockstep.
# LESLIDER_READ_CURRENT=false

# --- Teleoperator (teleoperator.py) — physical SO-101 leader -------------
# Serial port of the SO-101 leader arm (the one a human moves).
SO101_LEADER_PORT=/dev/tty.usbmodem58FA0830331
SO101_LEADER_ID=so101_leader

# Slider keyboard control parameters (Left/Right hold, Up/Down trim, Space stop).
LESLIDER_CRUISE_VELOCITY=1500
LESLIDER_SPEED_INCREMENT=250
LESLIDER_MIN_VELOCITY=100
LESLIDER_MAX_VELOCITY=3000
# LESLIDER_INVERT_SLIDER=false

# Where to save LeRobotDataset episodes. Defaults to ./data/<repo_id>.
PORTAL_HITL_DATASET_REPO_ID=local/portal-hitl
# PORTAL_HITL_DATASET_ROOT=./data/portal-hitl
PORTAL_HITL_DATASET_TASK=Pick the blue cube up and hold it

# --- Policy (policy.py / policies/<algo>/inference.py) -------------------
# Simulated VLA inference latency for the stub policy.py only — real
# policies/<algo>/inference.py drive their own model directly.
PORTAL_INFERENCE_LATENCY_MS=30

# ACT inference checkpoint (used by policies/act/inference.py).
# ACT_CHECKPOINT=checkpoints/act-leslider/025000

# Diffusion inference checkpoint.
# DIFFUSION_CHECKPOINT=checkpoints/diffusion-leslider/025000

# Optional task prompt threaded into the policy batch.
# LESLIDER_TASK=Pick the blue cube up and hold it

# --- Deploy (scripts/deploy_to_robot.sh) ---------------------------------
# Default rsync target for `./scripts/deploy_to_robot.sh`. Override at
# call time with `REMOTE=...` / `REMOTE_ROOT=...`.
# PORTAL_HITL_ROBOT_REMOTE=user@robot.local
# PORTAL_HITL_ROBOT_REMOTE_ROOT=~/workspace

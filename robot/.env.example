# LiveKit credentials.
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Room name. This must match whatever controller connects to the robot.
LIVEKIT_ROOM=portal-hitl

# Optional override of the fps declared in portal.yaml.
# PORTAL_FPS=30

# Physical leslider follower.
LESLIDER_PORT=/dev/ttyACM0
LESLIDER_ID=leslider

# Cameras. On Linux use /dev/video* paths; on macOS use integer indices.
LESLIDER_CAM_ARM=/dev/video0
LESLIDER_CAM_OVERHEAD=/dev/video2
LESLIDER_CAM_WIDTH=640
LESLIDER_CAM_HEIGHT=480

# Deploy helper defaults.
# PORTAL_ROBOT_REMOTE=user@robot.local
# PORTAL_ROBOT_REMOTE_ROOT=~/workspace
